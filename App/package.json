{
  "name": "cropvision-ai",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "mobile": "expo start --lan",
    "mobile:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "electron": "wait-on tcp:8081 && electron electron/main.js",
    "dev:desktop": "npx concurrently \"npm run web\" \"npm run electron\"",
    "build:win": "electron-builder --win",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/metro-config": "^55.0.9",
    "@expo/metro-runtime": "~55.0.6",
    "@react-navigation/drawer": "^7.9.4",
    "@types/react": "~19.2.10",
    "expo": "~55.0.26",
    "expo-constants": "^55.0.14",
    "expo-dev-client": "~55.0.35",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "55.0.14",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-media-library": "~55.0.17",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "2.30.1",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "typescript": "^5.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/cli": "^55.0.16",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "babel-preset-expo": "~55.0.8",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^29.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.18",
    "react-test-renderer": "^19.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "vn.edu.hcmus.cropvision",
    "productName": "CropVision AI",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "jest": {
    "preset": "jest-expo/node",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "watchPathIgnorePatterns": [
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "src/modules/**/*.{js,jsx,ts,tsx}",
      "src/modules/@core/**/*.{js,jsx,ts,tsx}"
    ]
  },
  "overrides": {
    "expo": {
      "@expo/cli": "$@expo/cli"
    },
    "react-native-worklets": "~0.7.0"
  }
}
