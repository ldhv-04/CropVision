{
  "name": "cropvision-ai",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "mobile": "expo start --lan",
    "mobile:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "electron": "wait-on tcp:8081 && electron electron/main.js",
    "dev:desktop": "npx concurrently \"npm run web\" \"npm run electron\"",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "@expo/metro-config": "^55.0.9",
    "@expo/metro-runtime": "~3.1.3",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@types/react": "~18.2.45",
    "expo": "^55.0.6",
    "expo-image-picker": "~14.7.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-web": "~0.19.6",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/cli": "^55.0.16",
    "@expo/ngrok": "^4.1.3",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "vn.edu.hcmus.cropvision",
    "productName": "CropVision AI",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "overrides": {
    "expo": {
      "@expo/cli": "$@expo/cli"
    }
  }
}
