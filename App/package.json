{
  "name": "cropvision-ai",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "mobile": "expo start --lan",
    "mobile:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "electron": "wait-on tcp:8081 && electron electron/main.js",
    "dev:desktop": "npx concurrently \"npm run web\" \"npm run electron\"",
    "build:win": "electron-builder --win",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/metro-config": "^55.0.9",
    "@expo/metro-runtime": "~55.0.6",
    "@types/react": "~19.2.10",
    "expo": "^55.0.6",
    "expo-constants": "^55.0.14",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "^55.0.13",
    "expo-router": "^55.0.12",
    "expo-status-bar": "^55.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "typescript": "^5.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/cli": "^55.0.16",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.16",
    "react-test-renderer": "^19.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "vn.edu.hcmus.cropvision",
    "productName": "CropVision AI",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "jest": {
    "preset": "jest-expo/node",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "watchPathIgnorePatterns": [
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "src/context/**/*.{js,jsx,ts,tsx}",
      "src/utils/**/*.{js,jsx,ts,tsx}",
      "src/config/**/*.{js,jsx,ts,tsx}",
      "src/constants/**/*.{js,jsx,ts,tsx}"
    ]
  },
  "overrides": {
    "expo": {
      "@expo/cli": "$@expo/cli"
    }
  }
}
