# CropVision App Environment Variables
# Copy this file to .env and fill in the values

# API Configuration
EXPO_PUBLIC_API_PROTOCOL=http
EXPO_PUBLIC_API_HOST=127.0.0.1
EXPO_PUBLIC_API_PORT=3000

# Alternative: full URL (overrides the above)
# EXPO_PUBLIC_API_ORIGIN=http://127.0.0.1:3000

# Gemini API (free tier) — get key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
